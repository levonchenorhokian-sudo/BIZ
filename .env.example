# MCP credentials for the Lebanon Uniform Market-Validation project.
#
# HOW TO USE (choose ONE, most secure first):
#   1. Preferred: set these as environment secrets in your Claude Code web
#      environment settings (they are injected as env vars, never committed).
#   2. Local runs only: copy this file to `.env` (which is gitignored) and
#      fill in values there.
#
# This .example file contains VARIABLE NAMES ONLY. Never put real secret
# values here, and never commit a populated .env.

# --- Core stack ---
GOOGLE_MAPS_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
AIRTABLE_API_KEY=
HUNTER_API_KEY=

# --- Optional enrichment ---
APOLLO_API_KEY=
APIFY_TOKEN=

# Playwright MCP requires NO credential (local browser automation).
