# Node — the hosting platform runs npm install itself; never commit or upload these
node_modules/
npm-debug.log*
.npm/

# graphify generated knowledge-graph output (regenerated locally / on commit)
graphify-out/

# Secrets — never commit real credentials
.env
.env.*
!.env.example

# generated single-file preview (rebuild: python3 tools/build-preview.py)
preview/

# generated catalogue intermediate (rebuild: python3 tools/build-catalogue.py)
catalogue/Merchandize-Catalogue.html
